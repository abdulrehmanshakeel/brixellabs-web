{
  "name": "brixellabs-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.js",
    "vercel-build": "vite build && node scripts/prerender.js",
    "prerender": "node scripts/prerender.js",
    "preview": "vite preview",
    "check-secrets": "node scripts/check_secrets.js",
    "backup-keys": "powershell -ExecutionPolicy Bypass -File scripts/backup_signing_key.ps1",
    "backup-db": "powershell -ExecutionPolicy Bypass -File scripts/backup_database.ps1",
    "load-test": "python backend/load_test.py --requests 1000 --concurrency 25",
    "load-balancer": "python backend/load_balancer.py --port 8000 --workers 8001 8002 8003"
