# ==============================================================================
# BrixelLabs Backend Environment Variables (TEMPLATE)
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file to Git!
# ==============================================================================

DJANGO_SECRET_KEY=your-cryptographically-random-secret-key-min-50-chars
DJANGO_DEBUG=False
DJANGO_ADMIN_URL=django-admin
ALLOWED_HOSTS=localhost,127.0.0.1,brixellabs.com,www.brixellabs.com

# --- Database Configuration ---
# For Local SQLite, leave DATABASE_URL empty.
# For Neon Cloud PostgreSQL:
# DATABASE_URL=postgresql://your_user:your_password@ep-xyz-123.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- SMTP Email Configuration ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_company_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_digit_gmail_app_password
ADMIN_NOTIFICATION_EMAIL=your_notification_recipient@gmail.com
