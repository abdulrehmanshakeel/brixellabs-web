# ==============================================================================
# BrixelLabs - Frontend Environment Variables
# ==============================================================================

# API Base URL (leave empty in production on same domain, or set for custom API backend)
VITE_API_URL=http://127.0.0.1:8000/api

# Cloudflare Turnstile Bot Detection
# Obtain your free site key from the Cloudflare Dashboard:
# https://dash.cloudflare.com/?to=/:account/turnstile
# Default test key (1x00000000000000000000AA) always passes for local development
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Google Analytics Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=
